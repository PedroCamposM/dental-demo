# Copia este archivo a .env.local y completa los valores (Supabase → Project Settings → API Keys).
# La publishable key es pública por diseño: los datos los protege RLS.
# NUNCA pongas aquí la secret / service_role key con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Módulos que requieren migraciones nuevas (1 = encendido). Ver src/lib/funciones.ts.
HABILITAR_PACIENTES=1
